    "# Cell 6: Plot training and validation curves\n",
    "\n",
    "def combine_histories(h1, h2):\n",
    "    combined = {}\n",
    "    for key in set(h1.history) | set(h2.history):\n",
    "        combined[key] = (\n",
    "            h1.history.get(key, [])\n",
    "            + h2.history.get(key, [])\n",
    "        )\n",
    "    return combined\n",
    "\n",
    "\n",
    "hist = combine_histories(history_head, history_finetune)\n",
    "epochs = range(1, len(hist[\"loss\"]) + 1)\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(epochs, hist[\"loss\"], label=\"Training Loss\")\n",
    "plt.plot(epochs, hist[\"val_loss\"], label=\"Validation Loss\")\n",
    "plt.title(\"MobileNetV2 - Loss\")\n",
    "plt.xlabel(\"Epoch\")\n",
    "plt.ylabel(\"Loss\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUTPUT_DIR / \"mobilenetv2_loss.png\", dpi=150)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(epochs, hist[\"accuracy\"], label=\"Training Accuracy\")\n",
    "plt.plot(epochs, hist[\"val_accuracy\"], label=\"Validation Accuracy\")\n",
    "plt.title(\"MobileNetV2 - Accuracy\")\n",
    "plt.xlabel(\"Epoch\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUTPUT_DIR / \"mobilenetv2_accuracy.png\", dpi=150)\n",
    "plt.show()\n",
    "\n",
    "pd.DataFrame(hist).to_csv(\n",
    "    OUTPUT_DIR / \"mobilenetv2_training_history.csv\",\n",
    "    index=False\n",
    ")"
