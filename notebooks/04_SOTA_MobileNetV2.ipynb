    "# Cell 3: Load the shared dataset, resize, and verify shapes\n",
    "\n",
    "# 1. Extract and resize arrays using your archive keys (handling lowercase source keys)\n",
    "x_tr_raw = archive['x_train'] if 'x_train' in archive.files else archive['X_train']\n",
    "x_v_raw = archive['x_val'] if 'x_val' in archive.files else archive['X_val']\n",
    "x_te_raw = archive['x_test'] if 'x_test' in archive.files else archive['X_test']\n",
    "\n",
    "y_train = archive['y_train'] if 'y_train' in archive.files else archive['Y_train']\n",
    "y_val = archive['y_val'] if 'y_val' in archive.files else archive['Y_val']\n",
    "y_test = archive['y_test'] if 'y_test' in archive.files else archive['Y_test']\n",
    "\n",
    "# Resize from 28x28x1 to 64x64x3 for MobileNetV2\n",
    "def prepare_images(images):\n",
    "    x = tf.convert_to_tensor(images, dtype=tf.float32)\n",
    "    if x.shape[-1] == 1:\n",
    "        x = tf.repeat(x, 3, axis=-1)\n",
    "    x = tf.image.resize(x, (64, 64), antialias=True)\n",
    "    return x.numpy().astype(\"float32\")\n",
    "\n",
    "# Define the exact uppercase variables expected by the assertions below\n",
    "X_train = prepare_images(x_tr_raw)\n",
    "X_val = prepare_images(x_v_raw)\n",
    "X_test = prepare_images(x_te_raw)\n",
    "\n",
    "# 2. Verify dataset shapes, pixel values, and class labels.\n",
    "assert X_train.shape[1:] == (64, 64, 3)\n",
    "assert X_val.shape[1:] == (64, 64, 3)\n",
    "assert X_test.shape[1:] == (64, 64, 3)\n",
    "\n",
    "assert len(X_train) == len(y_train)\n",
    "assert len(X_val) == len(y_val)\n",
    "assert len(X_test) == len(y_test)\n",
    "\n",
    "assert np.isfinite(X_train).all()\n",
    "assert np.isfinite(X_val).all()\n",
    "assert np.isfinite(X_test).all()\n",
    "\n",
    "assert set(np.unique(y_train)).issubset(set(range(10)))\n",
    "assert set(np.unique(y_val)).issubset(set(range(10)))\n",
    "assert set(np.unique(y_test)).issubset(set(range(10)))\n",
    "\n",
    "print(\"Training pixel range:\", X_train.min(), X_train.max())\n",
    "print(\"Validation pixel range:\", X_val.min(), X_val.max())\n",
    "print(\"Test pixel range:\", X_test.min(), X_test.max())\n",
    "print(\"Dataset checks passed.\")"
