   "source": [
    "# Cell 4: Build EfficientNetB0 with On-the-Fly Resizing Pipeline\n",
    "\n",
    "MODEL_NAME = \"EfficientNetB0\"\n",
    "MODEL_STEM = \"efficientnetb0\"\n",
    "NUM_CLASSES = 10\n",
    "\n",
    "BATCH_SIZE = 128\n",
    "HEAD_EPOCHS = 10\n",
    "FINE_TUNE_EPOCHS = 10\n",
    "FINE_TUNE_LAST_LAYERS = 20\n",
    "\n",
    "\n",
    "def preprocess_batch(images, labels):\n",
    "    images = tf.cast(images, tf.float32)\n",
    "    \n",
    "    # Ensure images have 3 channels (convert grayscale to RGB if needed)\n",
    "    if images.shape[-1] == 1 or len(images.shape) == 3:\n",
    "        if len(images.shape) == 3:\n",
    "            images = tf.expand_dims(images, axis=-1)\n",
    "        images = tf.repeat(images, 3, axis=-1)\n",
    "        \n",
    "    # Automatically resize any incoming shape (28x28, etc.) to 64x64\n",
    "    images = tf.image.resize(images, (64, 64))\n",
    "    \n",
    "    # EfficientNetB0 includes rescaling inside the Keras application.\n",
    "    # Keep pixel values in the [0, 255] range.\n",
    "    labels = tf.cast(labels, tf.int64)\n",
    "    return images, labels\n",
    "\n",
    "\n",
    "def make_dataset(images, labels, training=False):\n",
    "    ds = tf.data.Dataset.from_tensor_slices((images, labels))\n",
    "\n",
    "    if training:\n",
    "        ds = ds.shuffle(\n",
    "            buffer_size=min(len(images), 10000),\n",
    "            seed=SEED,\n",
    "            reshuffle_each_iteration=True\n",
    "        )\n",
    "\n",
    "    ds = ds.batch(BATCH_SIZE)\n",
    "    ds = ds.map(\n",
    "        preprocess_batch,\n",
    "        num_parallel_calls=tf.data.AUTOTUNE\n",
    "    )\n",
    "    return ds.prefetch(tf.data.AUTOTUNE)\n",
    "\n",
    "\n",
    "# Pass raw or prepared arrays directly; the pipeline will handle shape alignment\n",
    "train_ds = make_dataset(X_train, y_train, training=True)\n",
    "val_ds = make_dataset(X_val, y_val)\n",
    "test_ds = make_dataset(X_test, y_test)\n",
    "\n",
    "# Load pretrained EfficientNetB0.\n",
    "backbone = tf.keras.applications.EfficientNetB0(\n",
    "    include_top=False,\n",
    "    weights=\"imagenet\",\n",
    "    input_shape=(64, 64, 3)\n",
    ")\n",
    "\n",
    "backbone.trainable = False\n",
    "\n",
    "inputs = tf.keras.Input(shape=(64, 64, 3), name=\"image\")\n",
    "x = backbone(inputs, training=False)\n",
    "x = tf.keras.layers.GlobalAveragePooling2D()(x)\n",
    "x = tf.keras.layers.Dropout(0.2)(x)\n",
    "\n",
    "outputs = tf.keras.layers.Dense(\n",
    "    NUM_CLASSES,\n",
    "    activation=\"softmax\",\n",
    "    name=\"class_predictions\"\n",
    ")(x)\n",
    "\n",
    "model = tf.keras.Model(\n",
    "    inputs=inputs,\n",
    "    outputs=outputs,\n",
    "    name=\"EfficientNetB0_FashionMNIST\"\n",
    ")\n",
    "\n",
    "model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),\n",
    "    loss=\"sparse_categorical_crossentropy\",\n",
    "    metrics=[\"accuracy\"]\n",
    ")\n",
    "\n",
    "model.summary()\n",
    "\n",
    "print(\"Total parameters:\", f\"{model.count_params():,}\")\n",
    "print(\n",
    "    \"Initially trainable parameters:\",\n",
    "    f\"{sum(np.prod(v.shape) for v in model.trainable_weights):,}\"\n",
    ")"
   ]
  },
